<!--pages/user/index.wxml-->
<view class="container">
  <!-- 用户信息 -->
  <view class="user-header">
    <view class="user-info" wx:if="{{isLogin}}">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/avatar-default.png'}}" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="phone">{{userInfo.phone || ''}}</text>
      </view>
    </view>
    <view class="login-box" wx:else bindtap="login">
      <image class="avatar" src="/images/avatar-default.png" mode="aspectFill"></image>
      <text class="login-text">点击登录</text>
    </view>
  </view>

  <!-- 资产信息 -->
  <view class="assets-box card" wx:if="{{isLogin}}">
    <view class="asset-item" bindtap="goToPoints">
      <text class="asset-value">{{points}}</text>
      <text class="asset-label">积分</text>
    </view>
    <view class="asset-divider"></view>
    <view class="asset-item" bindtap="goToBalance">
      <text class="asset-value">¥{{balance}}</text>
      <text class="asset-label">余额</text>
    </view>
  </view>

  <!-- 订单入口 -->
  <view class="order-section card" wx:if="{{isLogin}}">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <view class="more-link" bindtap="goToOrders">
        <text>查看全部</text>
        <image class="arrow-icon" src="/images/arrow-right.png"></image>
      </view>
    </view>
    <view class="order-types">
      <view class="order-type" bindtap="goToOrders" data-status="0">
        <image class="type-icon" src="/images/order-unpaid.png"></image>
        <text class="type-name">待支付</text>
      </view>
      <view class="order-type" bindtap="goToOrders" data-status="2">
        <image class="type-icon" src="/images/order-unship.png"></image>
        <text class="type-name">待发货</text>
      </view>
      <view class="order-type" bindtap="goToOrders" data-status="3">
        <image class="type-icon" src="/images/order-unreceive.png"></image>
        <text class="type-name">待收货</text>
      </view>
      <view class="order-type" bindtap="goToOrders" data-status="4">
        <image class="type-icon" src="/images/order-finished.png"></image>
        <text class="type-name">已完成</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section card" wx:if="{{isLogin}}">
    <view class="menu-item" bindtap="goToPoints">
      <view class="menu-left">
        <image class="menu-icon" src="/images/points.png"></image>
        <text class="menu-name">我的积分</text>
      </view>
      <image class="arrow-icon" src="/images/arrow-right.png"></image>
    </view>
    <view class="menu-item" bindtap="goToExchange">
      <view class="menu-left">
        <image class="menu-icon" src="/images/exchange.png"></image>
        <text class="menu-name">积分兑换</text>
      </view>
      <image class="arrow-icon" src="/images/arrow-right.png"></image>
    </view>
    <view class="menu-item" bindtap="goToRecharge">
      <view class="menu-left">
        <image class="menu-icon" src="/images/recharge.png"></image>
        <text class="menu-name">充值中心</text>
      </view>
      <image class="arrow-icon" src="/images/arrow-right.png"></image>
    </view>
    <view class="menu-item" bindtap="goToBalance">
      <view class="menu-left">
        <image class="menu-icon" src="/images/balance.png"></image>
        <text class="menu-name">我的余额</text>
      </view>
      <image class="arrow-icon" src="/images/arrow-right.png"></image>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLogin}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
