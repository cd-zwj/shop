<!--pages/user/points.wxml-->
<view class="container">
  <!-- 积分余额 -->
  <view class="points-header">
    <text class="points-label">我的积分</text>
    <text class="points-value">{{points}}</text>
  </view>

  <!-- 积分明细 -->
  <view class="points-logs">
    <view class="section-title">积分明细</view>
    <view class="log-list">
      <view class="log-item" wx:for="{{logs}}" wx:key="id">
        <view class="log-left">
          <text class="log-reason">{{item.reason}}</text>
          <text class="log-time">{{item.createTime}}</text>
        </view>
        <text class="log-points {{item.points > 0 ? 'positive' : 'negative'}}">
          {{item.points > 0 ? '+' : ''}}{{item.points}}
        </text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{!loading && logs.length === 0}}">
      <image class="empty-image" src="/images/empty.png"></image>
      <text class="empty-text">暂无积分明细</text>
    </view>

    <!-- 加载更多 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && logs.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>
</view>
