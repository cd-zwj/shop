/* pages/user/exchange.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 积分余额 */
.points-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.info-label {
  font-size: 32rpx;
  color: #333;
}

.info-value {
  font-size: 48rpx;
  color: #1296db;
  font-weight: bold;
}

/* 兑换商品列表 */
.exchange-list {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.product-list {
  margin-top: 20rpx;
}

.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.points-box {
  display: flex;
  flex-direction: column;
}

.points-required {
  font-size: 32rpx;
  color: #1296db;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stock-text {
  font-size: 24rpx;
  color: #999;
}

.exchange-btn {
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #1296db;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: none;
}

.exchange-btn[disabled] {
  background-color: #ccc;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
