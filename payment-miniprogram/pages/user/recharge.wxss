/* pages/user/recharge.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 当前余额 */
.balance-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.info-label {
  font-size: 32rpx;
  color: #333;
}

.info-value {
  font-size: 48rpx;
  color: #f5222d;
  font-weight: bold;
}

/* 充值规则 */
.recharge-rules {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.rule-list {
  margin-top: 20rpx;
}

.rule-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.rule-item.active {
  border-color: #1296db;
  background-color: #f0f9ff;
}

.rule-amount {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-right: 20rpx;
}

.rule-bonus {
  flex: 1;
  padding: 8rpx 16rpx;
  background-color: #fff2e8;
  border-radius: 4rpx;
}

.rule-bonus text {
  font-size: 24rpx;
  color: #fa8c16;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 20rpx;
}

/* 充值说明 */
.recharge-tips {
  margin-bottom: 20rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
}

.tip-item {
  font-size: 26rpx;
  color: #999;
  line-height: 2;
}

/* 充值按钮 */
.recharge-actions {
  margin-top: 40rpx;
}

.recharge-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(to right, #1296db, #0e7ac4);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.recharge-btn[disabled] {
  background: #ccc;
}
