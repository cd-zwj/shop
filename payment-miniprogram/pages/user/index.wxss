/* pages/user/index.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 用户信息 */
.user-header {
  background: linear-gradient(to bottom, #1296db, #0e7ac4);
  padding: 60rpx 40rpx;
}

.user-info, .login-box {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-detail {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.login-text {
  font-size: 32rpx;
  color: #fff;
  margin-left: 30rpx;
}

/* 资产信息 */
.assets-box {
  display: flex;
  margin: -40rpx 20rpx 20rpx;
  padding: 40rpx 0;
}

.asset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-value {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.asset-label {
  font-size: 26rpx;
  color: #999;
}

.asset-divider {
  width: 1rpx;
  height: 80rpx;
  background-color: #f0f0f0;
}

/* 订单入口 */
.order-section {
  margin: 0 20rpx 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.more-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.order-types {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0 10rpx;
}

.order-type {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.type-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
}

.type-name {
  font-size: 26rpx;
  color: #666;
}

/* 功能菜单 */
.menu-section {
  margin: 0 20rpx 20rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.menu-name {
  font-size: 30rpx;
  color: #333;
}

/* 退出登录 */
.logout-section {
  margin: 40rpx 20rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #fff;
  color: #f5222d;
  border: 1rpx solid #f5222d;
  border-radius: 44rpx;
  font-size: 32rpx;
}
