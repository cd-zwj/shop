<!--pages/user/exchange.wxml-->
<view class="container">
  <!-- 积分余额 -->
  <view class="points-info card">
    <text class="info-label">当前积分</text>
    <text class="info-value">{{points}}</text>
  </view>

  <!-- 兑换商品列表 -->
  <view class="exchange-list">
    <view class="section-title">兑换商品</view>
    <view class="product-list">
      <view class="product-item" wx:for="{{products}}" wx:key="id">
        <image class="product-image" src="{{item.productImage}}" mode="aspectFill"></image>
        <view class="product-info">
          <text class="product-name">{{item.productName}}</text>
          <view class="product-footer">
            <view class="points-box">
              <text class="points-required">{{item.pointsRequired}}积分</text>
              <text class="stock-text">库存：{{item.stock}}</text>
            </view>
            <button class="exchange-btn" bindtap="exchange" data-id="{{item.id}}" disabled="{{points < item.pointsRequired || item.stock <= 0}}">
              {{item.stock > 0 ? '兑换' : '已兑完'}}
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{!loading && products.length === 0}}">
      <image class="empty-image" src="/images/empty.png"></image>
      <text class="empty-text">暂无可兑换商品</text>
    </view>
  </view>
</view>
