<!--pages/product/detail.wxml-->
<view class="container">
  <!-- 商品图片 -->
  <view class="product-images">
    <swiper class="swiper" indicator-dots="{{true}}" autoplay="{{false}}">
      <swiper-item>
        <image class="product-image" src="{{product.imageUrl}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 商品信息 -->
  <view class="product-info card">
    <view class="price-box">
      <text class="price">¥{{product.price}}</text>
      <text class="sales">已售{{product.sales || 0}}</text>
    </view>
    <text class="product-name">{{product.name}}</text>
    <text class="product-desc">{{product.description}}</text>
  </view>

  <!-- 商品详情 -->
  <view class="product-detail card">
    <view class="detail-title">商品详情</view>
    <view class="detail-item">
      <text class="label">商品编码：</text>
      <text class="value">{{product.productCode}}</text>
    </view>
    <view class="detail-item">
      <text class="label">分类：</text>
      <text class="value">{{product.category}}</text>
    </view>
    <view class="detail-item">
      <text class="label">库存：</text>
      <text class="value">{{product.stock}}</text>
    </view>
    <view class="detail-item">
      <text class="label">状态：</text>
      <text class="value {{product.stock > 0 ? 'text-success' : 'text-danger'}}">
        {{product.stock > 0 ? '有货' : '缺货'}}
      </text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer-bar">
    <view class="footer-left">
      <view class="footer-btn" bindtap="goToHome">
        <image class="footer-icon" src="/images/home.png"></image>
        <text>首页</text>
      </view>
    </view>
    <view class="footer-right">
      <button class="buy-btn" bindtap="buyNow" disabled="{{product.stock <= 0}}">
        {{product.stock > 0 ? '立即购买' : '已售罄'}}
      </button>
    </view>
  </view>
</view>
