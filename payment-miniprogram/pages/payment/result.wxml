<!--pages/payment/result.wxml-->
<view class="container">
  <!-- 支付结果 -->
  <view class="result-box">
    <image class="result-icon" src="/images/{{success ? 'success' : 'fail'}}.png"></image>
    <text class="result-text">{{success ? '支付成功' : '支付失败'}}</text>
    <text class="result-desc" wx:if="{{success}}">订单已提交，请等待商家发货</text>
    <text class="result-desc" wx:else>支付遇到问题，请稍后重试</text>
  </view>

  <!-- 订单信息 -->
  <view class="order-info card" wx:if="{{order.orderNo}}">
    <view class="info-item">
      <text class="label">订单号</text>
      <text class="value">{{order.orderNo}}</text>
    </view>
    <view class="info-item" wx:if="{{success}}">
      <text class="label">支付金额</text>
      <text class="value price">¥{{order.paidAmount}}</text>
    </view>
    <view class="info-item" wx:if="{{success}}">
      <text class="label">支付时间</text>
      <text class="value">{{order.payTime}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="action-btn default" bindtap="goToHome">返回首页</button>
    <button class="action-btn primary" bindtap="goToOrders">查看订单</button>
  </view>
</view>
