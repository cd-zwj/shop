/* pages/payment/pay.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 支付金额 */
.payment-amount {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.amount-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.amount-value {
  font-size: 72rpx;
  color: #f5222d;
  font-weight: bold;
}

/* 订单信息 */
.order-info {
  margin-top: 20rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: #666;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 400rpx;
}

/* 支付方式 */
.payment-method {
  margin-top: 20rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.method-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.method-left {
  display: flex;
  align-items: center;
}

.method-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.method-name {
  font-size: 28rpx;
  color: #333;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 支付按钮 */
.payment-actions {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pay-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(to right, #1296db, #0e7ac4);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.cancel-text {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #999;
}
