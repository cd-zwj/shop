/* pages/payment/result.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 支付结果 */
.result-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}

.result-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.result-text {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.result-desc {
  font-size: 28rpx;
  color: #999;
}

/* 订单信息 */
.order-info {
  margin-top: 40rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: #666;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 400rpx;
}

.info-item .price {
  color: #f5222d;
  font-weight: bold;
}

/* 操作按钮 */
.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 60rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin: 0 10rpx;
}

.action-btn.default {
  background-color: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.action-btn.primary {
  background: linear-gradient(to right, #1296db, #0e7ac4);
  color: #fff;
  border: none;
}
