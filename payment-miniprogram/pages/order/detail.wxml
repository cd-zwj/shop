<!--pages/order/detail.wxml-->
<view class="container">
  <!-- 订单状态 -->
  <view class="order-status card">
    <image class="status-icon" src="/images/status-{{order.orderStatus}}.png"></image>
    <text class="status-text" style="color: {{order.statusColor}}">{{order.statusText}}</text>
  </view>

  <!-- 商品信息 -->
  <view class="product-section card">
    <view class="section-title">商品信息</view>
    <view class="product-item" wx:for="{{order.items}}" wx:key="id">
      <image class="product-image" src="{{item.productImage}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.productName}}</text>
        <view class="product-footer">
          <text class="product-price">¥{{item.price}}</text>
          <text class="product-quantity">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info card">
    <view class="section-title">订单信息</view>
    <view class="info-item">
      <text class="label">订单号</text>
      <text class="value">{{order.orderNo}}</text>
    </view>
    <view class="info-item">
      <text class="label">创建时间</text>
      <text class="value">{{order.createTime}}</text>
    </view>
    <view class="info-item" wx:if="{{order.payTime}}">
      <text class="label">支付时间</text>
      <text class="value">{{order.payTime}}</text>
    </view>
    <view class="info-item" wx:if="{{order.shipTime}}">
      <text class="label">发货时间</text>
      <text class="value">{{order.shipTime}}</text>
    </view>
    <view class="info-item" wx:if="{{order.finishTime}}">
      <text class="label">完成时间</text>
      <text class="value">{{order.finishTime}}</text>
    </view>
  </view>

  <!-- 金额信息 -->
  <view class="amount-info card">
    <view class="section-title">金额信息</view>
    <view class="info-item">
      <text class="label">商品金额</text>
      <text class="value">¥{{order.totalAmount}}</text>
    </view>
    <view class="info-item" wx:if="{{order.balanceAmount > 0}}">
      <text class="label">余额抵扣</text>
      <text class="value text-success">-¥{{order.balanceAmount}}</text>
    </view>
    <view class="info-item total">
      <text class="label">实付金额</text>
      <text class="value price">¥{{order.paidAmount}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer-bar" wx:if="{{order.orderStatus === 0 || order.orderStatus === 3}}">
    <button class="action-btn default" wx:if="{{order.orderStatus === 0}}" bindtap="cancelOrder">取消订单</button>
    <button class="action-btn primary" wx:if="{{order.orderStatus === 0}}" bindtap="payOrder">去支付</button>
    <button class="action-btn primary" wx:if="{{order.orderStatus === 3}}" bindtap="confirmOrder">确认收货</button>
  </view>
</view>
