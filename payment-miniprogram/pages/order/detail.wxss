/* pages/order/detail.wxss */
.container {
  padding-bottom: 120rpx;
  background-color: #f5f5f5;
}

/* 订单状态 */
.order-status {
  margin: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.status-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
}

/* 商品信息 */
.product-section {
  margin: 20rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  color: #f5222d;
  font-weight: bold;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

/* 订单信息 */
.order-info, .amount-info {
  margin: 20rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: #666;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 400rpx;
}

.info-item.total {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
  margin-top: 12rpx;
}

.info-item.total .label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.info-item .price {
  font-size: 36rpx;
  color: #f5222d;
  font-weight: bold;
}

/* 底部操作栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-end;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.action-btn {
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 32rpx;
  border-radius: 40rpx;
  margin-left: 20rpx;
}

.action-btn.default {
  background-color: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.action-btn.primary {
  background: linear-gradient(to right, #1296db, #0e7ac4);
  color: #fff;
  border: none;
}
