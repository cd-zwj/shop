<!--pages/order/list.wxml-->
<view class="container">
  <!-- 状态筛选 -->
  <view class="status-tabs">
    <view class="tab-item {{statusFilter === '' ? 'active' : ''}}" bindtap="changeStatus" data-status="">
      <text>全部</text>
    </view>
    <view class="tab-item {{statusFilter === '0' ? 'active' : ''}}" bindtap="changeStatus" data-status="0">
      <text>待支付</text>
    </view>
    <view class="tab-item {{statusFilter === '2' ? 'active' : ''}}" bindtap="changeStatus" data-status="2">
      <text>待发货</text>
    </view>
    <view class="tab-item {{statusFilter === '3' ? 'active' : ''}}" bindtap="changeStatus" data-status="3">
      <text>待收货</text>
    </view>
    <view class="tab-item {{statusFilter === '4' ? 'active' : ''}}" bindtap="changeStatus" data-status="4">
      <text>已完成</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-item card" wx:for="{{orders}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status" style="color: {{item.statusColor}}">{{item.statusText}}</text>
      </view>

      <!-- 商品信息 -->
      <view class="order-products" bindtap="goToDetail" data-order-no="{{item.orderNo}}">
        <view class="product-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="product">
          <image class="product-image" src="{{product.productImage}}" mode="aspectFill"></image>
          <view class="product-info">
            <text class="product-name">{{product.productName}}</text>
            <view class="product-footer">
              <text class="product-price">¥{{product.price}}</text>
              <text class="product-quantity">x{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单金额 -->
      <view class="order-amount">
        <text class="amount-label">实付金额：</text>
        <text class="amount-value">¥{{item.paidAmount}}</text>
      </view>

      <!-- 订单操作 -->
      <view class="order-actions">
        <button class="action-btn default" wx:if="{{item.orderStatus === 0}}" bindtap="cancelOrder" data-order-no="{{item.orderNo}}">取消订单</button>
        <button class="action-btn primary" wx:if="{{item.orderStatus === 0}}" bindtap="payOrder" data-order-no="{{item.orderNo}}">去支付</button>
        <button class="action-btn primary" wx:if="{{item.orderStatus === 3}}" bindtap="confirmOrder" data-order-no="{{item.orderNo}}">确认收货</button>
        <button class="action-btn default" bindtap="goToDetail" data-order-no="{{item.orderNo}}">查看详情</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <image class="empty-image" src="/images/empty.png"></image>
    <text class="empty-text">暂无订单</text>
  </view>

  <!-- 加载更多 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>
